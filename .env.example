# Variables du docker-compose (copier en .env, non versionné).

# Secret partagé entre le Document Server et le backend : MÊME valeur que dans backend/.env.
# Générer par ex. avec :  python -c "import secrets; print(secrets.token_urlsafe(48))"
ONLYOFFICE_JWT_SECRET=

# Port publié du Document Server sur la machine hôte.
ONLYOFFICE_PORT=8080

# Version figée de l'image onlyoffice/documentserver.
ONLYOFFICE_VERSION=9.4.0.1
