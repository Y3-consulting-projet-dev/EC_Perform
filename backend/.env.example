# Copier en backend/.env (non versionné).

MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ec_perform
# Secret de signature des sessions de l'API (obligatoire).
JWT_SECRET_KEY=

# --- ONLYOFFICE Docs (Phase 6 – rapport final) --------------------------------------------
# Secret JWT du Document Server : même valeur que ONLYOFFICE_JWT_SECRET du .env racine
# (docker-compose). Sans lui, l'éditeur et l'export PDF sont indisponibles (HTTP 503).
ONLYOFFICE_JWT_SECRET=673054558b183d92d52c2f8415e51380f58bc9e1dd53f3bb936b79c997e1f929
# URL du Document Server vue par le NAVIGATEUR (chargement de api.js, URL des fichiers modifiés).
ONLYOFFICE_PUBLIC_URL=http://localhost:8080
# URL du Document Server vue par le BACKEND (fichier modifié, conversion PDF). Par défaut :
# ONLYOFFICE_PUBLIC_URL. Les URL renvoyées par le Document Server sont réécrites de l'une vers
# l'autre ; toute autre origine est refusée.
ONLYOFFICE_INTERNAL_URL=http://localhost:8080
# URL du BACKEND vue par le Document Server (téléchargement du fichier, callback).
# Docker Desktop : host.docker.internal ; Docker dans WSL / Linux : IP de l'hôte sur le réseau docker.
BACKEND_URL_FOR_ONLYOFFICE=http://host.docker.internal:8000
# En-tête portant le JWT des requêtes du Document Server (JWT_HEADER du conteneur).
ONLYOFFICE_JWT_HEADER=Authorization
